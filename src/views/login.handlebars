<div class="main-container">
  <div class="header">
    <h2 class="title">Chatapp</h2>
    <h3 class="subtitle">Mantente comunicado con tus amigos</h3>
  </div>
  <div class="form-container">
    <form class="w-100">
      <input
        type="email"
        class="form-control"
        id="email"
        name="email"
        placeholder="Enter your email"
      />
      <input
        type="password"
        class="form-control"
        id="password"
        name="password"
        placeholder="Enter your password"
      />
      <div class="w-100">
        <button type="submit" class="btn-submit">Iniciar sesión con email</button>
      </div>
    </form>
    <div class="separator">
      <div class="separator-bar"></div>
      <p class="separator-text">O</p>
    </div>
    <form>
      <button class="oauth-btn">
        <img src="/img/icons/google.svg" alt="google icon" class="oauth-icon" />
        <p class="oauth-text">Continuar con google</p>
      </button>
      <button class="oauth-btn">
        <img src="/img/icons/github.svg" alt="github icon" class="oauth-icon" />
        <p class="oauth-text">Continuar con github</p>
      </button>
    </form>
    <div class="d-flex justify-content-center mt-3">
        <p class="message-text">Todavía no eres miembro, <a class="link" href="/register">Registrate aquí</a></p>
    </div>
  </div>
</div>