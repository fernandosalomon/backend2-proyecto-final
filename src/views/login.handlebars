<div class="card">
  <div class="logo-area">
    <div class="logo-mark">
      <svg viewBox="0 0 20 20">
        <path
          d="M3 4.5C3 3.67 3.67 3 4.5 3h11C16.33 3 17 3.67 17 4.5v8c0 .83-.67 1.5-1.5 1.5H7l-4 3V4.5z"
        />
      </svg>
    </div>
    <span class="logo-name">Chatapp</span>
  </div>

  <h1 class="form-title">Bienvenido de nuevo</h1>
  <p class="form-subtitle">Ingresa a tu cuenta para continuar conversando.</p>

  <form id="loginForm">
    <div class="field">
      <label for="email">Correo electrónico</label>
      <input
        type="email"
        id="email"
        placeholder="tu@correo.com"
        autocomplete="email"
        name="email"
      />
    </div>

    <div class="field field-pass">
      <div class="password-row">
        <label for="password" class="mb-0">Contraseña</label>
        <a href="#" class="forgot-password">¿Olvidaste tu contraseña?</a>
      </div>
      <input
        type="password"
        id="password"
        placeholder="••••••••"
        autocomplete="current-password"
        class="mt-3"
        name="password"
      />
    </div>

    <button class="btn-primary">Iniciar sesión</button>
  </form>

  <div class="divider"><span>o continúa con</span></div>

  <div class="d-flex flex-column gap-3">
     <button class="btn-oauth d-none">
    <img src="/img/icons/google.svg" />
    <p class="m-0">Continuar con Google</p>
  </button>

  <button class="btn-oauth">
    <img src="/img/icons/github.svg" />
    <p class="m-0">Continuar con Github</p>
  </button>
  </div>

  <p class="signup">¿No tienes cuenta? <a href="/api/v1/register">Regístrate gratis</a></p>

</div>
<script src="/js/login.js"></script>