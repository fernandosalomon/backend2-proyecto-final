<div class="main-container">
  <div class="header">
    <h2 class="title">Chatapp</h2>
    <h3 class="subtitle">Mantente comunicado con tus amigos</h3>
  </div>
  <div class="form-container">
    <form class="w-100">
      <div class="d-flex gap-2">
        <input
          type="text"
          class="form-control"
          id="firstname"
          name="firstname"
          placeholder="Nombre"
        />
        <input
          type="text"
          class="form-control"
          id="lastname"
          name="lastname"
          placeholder="Apellido"
        />
      </div>
      <input
        type="email"
        class="form-control"
        id="email"
        name="email"
        placeholder="Enter your email"
      />
      <div>
        <input
          type="password"
          class="form-control"
          id="password"
          name="password"
          placeholder="Enter your password"
          autocomplete="off"
        />
        <div id="password-check" style="display: none;" class="ms-3 mt-3">
          <h5 class="mb-3">La contraseña debe contener:</h5>
          <p id="hasLowercase"></p>
          <p id="hasUppercase"></p>
          <p id="hasNumber"></p>
          <p id="hasEightCharacters"></p>
        </div>
      </div>
      <div class="w-100">
        <button type="submit" class="btn-submit">Registrarse con email</button>
      </div>
    </form>
    <div class="separator">
      <div class="separator-bar"></div>
      <p class="separator-text">O</p>
    </div>
    <form>
      <button class="oauth-btn">
        <img src="/img/icons/google.svg" alt="google icon" class="oauth-icon" />
        <p class="oauth-text">Registrarse con google</p>
      </button>
      <button class="oauth-btn">
        <img src="/img/icons/github.svg" alt="github icon" class="oauth-icon" />
        <p class="oauth-text">Registrarse con github</p>
      </button>
    </form>
    <div class="d-flex justify-content-center mt-3">
      <p class="message-text">Ya tienes una cuenta,
        <a class="link" href="/login">Inicia sesión aquí</a></p>
    </div>
  </div>
</div>

<script src="/js/passwordCheck.js"></script>