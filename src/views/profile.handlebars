<div class="card p-0">
  <div class="cover"></div>
  <div class="card-body">
 
    <div class="avatar-wrap">
      <div class="avatar">
        <img src="/img/avatar.svg" alt="avatar">
      </div>
    </div>
 
    <div class="profile-name">{{this.user.firstname}} {{this.user.lastname}}</div>
 
    <div class="divider"></div>
 
    <div class="fields">
      <div class="field-row">
        <div class="field-icon">
          <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div class="field-text">
          <div class="field-label">Nombre completo</div>
          <div class="field-val">{{this.user.firstname}} {{this.user.lastname}}</div>
        </div>
      </div>
 
      <div class="field-row">
        <div class="field-icon">
          <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <div class="field-text">
          <div class="field-label">Correo electrónico</div>
          <div class="field-val">{{this.user.email}}</div>
        </div>
      </div>
 
      <div class="field-row">
        <div class="field-icon">
          <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <div class="field-text">
          <div class="field-label">Domicilio</div>
          <div class="field-val">Av. Corrientes 1234, Buenos Aires</div>
        </div>
      </div>
    </div>
 
  </div>
</div>
