<div class="main-container d-flex align-items-center justify-content-center">
  <div class="error-page-wrapper">

    <!-- Header -->
    <div class="chat-header">
      <div class="avatar">
        <svg viewBox="0 0 24 24"><path
            d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"
          /></svg>
      </div>
      <div class="header-info">
        <div class="header-name">ChatBot IA</div>
        <div class="header-status">
          <div class="status-dot"></div>
          Acceso denegado
        </div>
      </div>
      <div class="code-display">403</div>
    </div>

    <!-- Card de error -->
    <div class="card">
      <div class="error-pill">
        <svg
          width="10"
          height="10"
          viewBox="0 0 24 24"
          stroke="#fbbf24"
          fill="none"
          stroke-width="2.5"
          stroke-linecap="round"
        >
          <path
            d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
          />
          <line x1="12" y1="9" x2="12" y2="13" />
          <line x1="12" y1="17" x2="12.01" y2="17" />
        </svg>
        ERROR 403 · FORBIDDEN
      </div>
      <div class="card-title">Acceso prohibido</div>
      <div class="card-desc">No tienes permisos para acceder a este recurso. Si crees que es un error, contacta con el administrador.</div>
      <div class="path-tag">GET /area-restringida → 403 Forbidden</div>
    </div>

    <!-- Botones de acción -->
    <div class="actions">
      <a href="/" class="btn btn-primary">
        <svg viewBox="0 0 24 24">
          <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
          <polyline points="9 22 9 12 15 12 15 22" />
        </svg>
        Ir al inicio
      </a>
      <button onclick="history.back()" class="btn btn-secondary">
        <svg viewBox="0 0 24 24">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        Volver atrás
      </button>
    </div>

    <p class="footer-note"><span>ChatBot IA</span>
      · Todos los derechos reservados</p>

  </div>
</div>